# Copia este archivo como .env y completa los dos primeros valores.
# Todo se saca del panel web de Supabase (https://supabase.com/dashboard).

# --------------------------------------------------------------------------
# URL del proyecto
#
# Botón "Connect" (arriba en el panel) -> Project URL
#
# Atajo: es https://<ID>.supabase.co, donde <ID> es el código que aparece
# en la barra de direcciones: supabase.com/dashboard/project/<ID>
# --------------------------------------------------------------------------
SUPABASE_URL=

# --------------------------------------------------------------------------
# Llave secreta (acceso total, solo para el servidor)
#
# Settings (engrane) -> API Keys -> sección "Secret keys" -> Reveal
# Empieza con sb_secret_
#
# Si tu proyecto usa las llaves antiguas, entra a la pestaña
# "Legacy API Keys" y copia la llave "service_role".
#
# ⚠️  Esta llave ignora las políticas de seguridad (RLS): úsala solo en el
#     servidor. Nunca la pegues en el frontend ni la subas a git.
# --------------------------------------------------------------------------
SUPABASE_SECRET_KEY=

# --------------------------------------------------------------------------
# Buckets de Storage que crea supabase/schema.sql.
# Solo cámbialos si les pusiste otro nombre.
# --------------------------------------------------------------------------
SUPABASE_BUCKET_PDF=recursos-pdf
SUPABASE_BUCKET_IMAGES=recursos-imagenes

# Puerto del API
PORT=4000
